```tsx
// ✅ Good - Large data handling
export function useVirtualizedSessions(spaceId: string) {
  const { data: sessions = [] } = useSessionsApi(spaceId);

  const virtualizedData = useMemo(() => {
    return sessions.map((session, index) => ({
      id: session.id,
      data: session,
      index,
    }));
  }, [sessions]);

  return {
    data: virtualizedData,
    totalCount: sessions.length,
  };
}

// ✅ Good - Data cleanup
export function useSessionCleanup() {
  const queryClient = useQueryClient();

  useEffect(() => {
    const cleanup = () => {
      // Remove old session data from cache
      const now = Date.now();
      const staleTime = 24 * 60 * 60 * 1000; // 24 hours

      queryClient
        .getQueryCache()
        .getAll()
        .forEach((query) => {
          if (query.queryKey[0] === "sessions") {
            const lastUpdated = query.state.dataUpdatedAt;
            if (now - lastUpdated > staleTime) {
              queryClient.removeQueries({ queryKey: query.queryKey });
            }
          }
        });
    };

    const interval = setInterval(cleanup, 60 * 60 * 1000); // Run every hour
    return () => clearInterval(interval);
  }, [queryClient]);
}
```

