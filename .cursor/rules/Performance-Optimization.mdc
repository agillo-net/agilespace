```tsx
// ✅ Good - Route-based code splitting
import { lazy, Suspense } from "react";

const SessionChart = lazy(() => import("./session-chart"));
const SessionReport = lazy(() => import("./session-report"));
const Analytics = lazy(() => import("./analytics"));

