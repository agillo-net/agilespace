## Screen Reader Support

### Screen Reader Announcements

- Use ARIA live regions for dynamic content
- Provide appropriate announcements
- Use screen reader only text
- Handle loading states

```tsx
// ✅ Good - Screen reader announcements
export function ScreenReaderAnnouncements() {
  const [announcement, setAnnouncement] = useState("");

  const announceToScreenReader = (message: string) => {
    setAnnouncement(message);
    // Clear announcement after a delay
    setTimeout(() => setAnnouncement(""), 1000);
  };

  return (
    <>
      {/* Live region for announcements */}
      <div aria-live="polite" aria-atomic="true" className="sr-only">
        {announcement}
      </div>

      {/* Screen reader only content */}
      <div className="sr-only">
        <h1>AgileSpace Dashboard</h1>
        <p>Track your team's work sessions and productivity</p>
      </div>
    </>
  );
}

// ✅ Good - Loading announcements
export function LoadingAnnouncement({ isLoading, message }: LoadingProps) {
  return (
    <div aria-live="polite" aria-atomic="true" className="sr-only">
      {isLoading ? `Loading ${message}...` : `${message} loaded`}
    </div>
  );
}
```

### Alternative Text

- Provide meaningful alt text for images
- Use descriptive link text
- Provide text alternatives for icons
- Handle decorative images

```tsx
// ✅ Good - Image accessibility
export function AccessibleImage({
  src,
  alt,
  decorative = false,
  ...props
}: ImageProps) {
  if (decorative) {
    return <img src={src} alt="" role="presentation" {...props} />;
  }

  return <img src={src} alt={alt} {...props} />;
}

// ✅ Good - Icon accessibility
export function AccessibleIcon({
  icon: Icon,
  label,
  decorative = false,
  ...props
}: IconProps) {
  if (decorative) {
    return <Icon aria-hidden="true" {...props} />;
  }

  return <Icon aria-label={label} role="img" {...props} />;
}

// ✅ Good - Link accessibility
export function AccessibleLink({
  href,
  children,
  external = false,
  ...props
}: LinkProps) {
  return (
    <a
      href={href}
      {...(external && {
        target: "_blank",
        rel: "noopener noreferrer",
      })}
      {...props}
    >
      {children}
      {external && <span className="sr-only"> (opens in new tab)</span>}
    </a>
  );
}
```

