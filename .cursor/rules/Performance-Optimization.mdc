# Performance Optimization for AgileSpace

## React Performance

### Component Optimization

- Use React.memo for expensive components
- Implement useCallback for event handlers
- Use useMemo for expensive calculations
- Avoid unnecessary re-renders

```tsx
// ✅ Good - Optimized component
export const SessionCard = React.memo(function SessionCard({
  session,
  onEndSession,
  onEditSession,
}: SessionCardProps) {
  const handleEndSession = useCallback(() => {
    onEndSession(session.id);
  }, [session.id, onEndSession]);

  const handleEditSession = useCallback(() => {
    onEditSession(session);
  }, [session, onEditSession]);

  const formattedDuration = useMemo(() => {
    return formatDuration(session.start_time, session.end_time);
  }, [session.start_time, session.end_time]);

  return (
    <Card className="hover:shadow-md transition-shadow">
      <CardHeader>
        <CardTitle className="text-lg">{session.title}</CardTitle>
        <p className="text-sm text-muted-foreground">{session.description}</p>
      </CardHeader>
      <CardContent>
        <div className="flex items-center justify-between">
          <span className="text-sm text-muted-foreground">
            {formattedDuration}
          </span>
          <div className="flex space-x-2">
            <Button size="sm" variant="outline" onClick={handleEditSession}>
              Edit
            </Button>
            <Button size="sm" variant="destructive" onClick={handleEndSession}>
              End
            </Button>
          </div>
        </div>
      </CardContent>
    </Card>
  );
});
```

