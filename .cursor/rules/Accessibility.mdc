// ✅ Good - Image accessibility
export function AccessibleImage({
  src,
  alt,
  decorative = false,
  ...props
}: ImageProps) {
  if (decorative) {
    return <img src={src} alt="" role="presentation" {...props} />;
  }

  return <img src={src} alt={alt} {...props} />;
}

// ✅ Good - Icon accessibility
export function AccessibleIcon({
  icon: Icon,
  label,
  decorative = false,
  ...props
}: IconProps) {
  if (decorative) {
    return <Icon aria-hidden="true" {...props} />;
  }

  return <Icon aria-label={label} role="img" {...props} />;
}

// ✅ Good - Link accessibility
export function AccessibleLink({
  href,
  children,
  external = false,
  ...props
}: LinkProps) {
  return (
    <a
      href={href}
      {...(external && {
        target: "_blank",
        rel: "noopener noreferrer",
      })}
      {...props}
    >
      {children}
      {external && <span className="sr-only"> (opens in new tab)</span>}
    </a>
  );
}
