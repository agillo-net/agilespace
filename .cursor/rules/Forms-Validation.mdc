# Forms & Validation for AgileSpace

## Form Management

### React Hook Form

- Use react-hook-form for form state management
- Leverage zod for schema validation
- Use controlled inputs for better UX
- Implement proper form submission handling

```tsx
// ✅ Good - Form with react-hook-form and zod
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";

const sessionSchema = z.object({
  title: z
    .string()
    .min(1, "Title is required")
    .max(100, "Title must be less than 100 characters"),
  description: z.string().optional(),
  track_id: z.string().optional(),
  tags: z.array(z.string()).optional(),
  estimated_duration: z
    .number()
    .min(1, "Duration must be at least 1 minute")
    .optional(),
});

type SessionFormData = z.infer<typeof sessionSchema>;

export function SessionForm({ onSubmit, defaultValues }: SessionFormProps) {
  const form = useForm<SessionFormData>({
    resolver: zodResolver(sessionSchema),
    defaultValues: {
      title: "",
      description: "",
      tags: [],
      ...defaultValues,
    },
  });

  const handleSubmit = form.handleSubmit((data) => {
    onSubmit(data);
  });

  return (
    <form onSubmit={handleSubmit} className="space-y-6">
      <div className="space-y-2">
        <Label htmlFor="title">Session Title *</Label>
        <Input
          id="title"
          {...form.register("title")}
          placeholder="Enter session title"
          className={cn(form.formState.errors.title && "border-destructive")}
        />
        {form.formState.errors.title && (
          <p className="text-sm text-destructive">
            {form.formState.errors.title.message}
          </p>
        )}
      </div>

      <div className="space-y-2">
        <Label htmlFor="description">Description</Label>
        <Textarea
          id="description"
          {...form.register("description")}
          placeholder="Enter session description"
          className="min-h-[100px]"
        />
      </div>

      <div className="flex items-center justify-end space-x-2">
        <Button type="button" variant="outline" onClick={form.reset}>
          Reset
        </Button>
        <Button type="submit" disabled={form.formState.isSubmitting}>
          {form.formState.isSubmitting ? "Saving..." : "Save Session"}
        </Button>
      </div>
    </form>
  );
}
```

### Form Components

- Create reusable form components
- Use consistent form patterns
- Implement proper accessibility
- Handle loading and error states

```tsx
// ✅ Good - Reusable form components
interface FormFieldProps {
  label: string;
  name: string;
  type?: "text" | "email" | "password" | "number" | "textarea";
  placeholder?: string;
  required?: boolean;
  error?: string;
  register: UseFormRegister<any>;
}

export function FormField({
  label,
  name,
  type = "text",
  placeholder,
  required,
  error,
  register,
}: FormFieldProps) {
  const id = `field-${name}`;

  return (
    <div className="space-y-2">
      <Label
        htmlFor={id}
        className={cn(
          required && 'after:content-["*"] after:ml-0.5 after:text-destructive'
        )}
      >
        {label}
      </Label>

      {type === "textarea" ? (
        <Textarea
          id={id}
          {...register(name)}
          placeholder={placeholder}
          className={cn(error && "border-destructive")}
        />
      ) : (
        <Input
          id={id}
          type={type}
          {...register(name)}
          placeholder={placeholder}
          className={cn(error && "border-destructive")}
        />
      )}

      {error && <p className="text-sm text-destructive">{error}</p>}
    </div>
  );
}
```

## Validation Strategies

### Client-Side Validation

- Use zod schemas for type-safe validation
- Provide immediate feedback to users
- Validate on blur and submit
- Show clear error messages

```tsx
// ✅ Good - Comprehensive validation schema
const userProfileSchema = z.object({
  name: z
    .string()
    .min(2, "Name must be at least 2 characters")
    .max(50, "Name must be less than 50 characters")
    .regex(/^[a-zA-Z\s]+$/, "Name can only contain letters and spaces"),

  email: z
    .string()
    .email("Please enter a valid email address")
    .min(1, "Email is required"),

  avatar_url: z
    .string()
    .url("Please enter a valid URL")
    .optional()
    .or(z.literal("")),

  timezone: z.string().min(1, "Timezone is required"),

  working_hours: z
    .object({
      start: z
        .string()
        .regex(/^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$/, "Invalid time format"),
      end: z
        .string()
        .regex(/^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$/, "Invalid time format"),
    })
    .refine(
      (data) => {
        const start = new Date(`2000-01-01T${data.start}`);
        const end = new Date(`2000-01-01T${data.end}`);
        return start < end;
      },
      {
        message: "End time must be after start time",
        path: ["end"],
      }
    ),
});

type UserProfileFormData = z.infer<typeof userProfileSchema>;
```

### Server-Side Validation

- Always validate on the server
- Use the same schemas for consistency
- Handle validation errors gracefully
- Provide meaningful error responses

```tsx
// ✅ Good - Server-side validation
export async function updateUserProfile(
  userId: string,
  data: UserProfileFormData
) {
  try {
    // Validate on server
    const validatedData = userProfileSchema.parse(data);

    const { error } = await supabase
      .from("profiles")
      .update(validatedData)
      .eq("id", userId);

    if (error) {
      throw new Error(error.message);
    }

    return { success: true };
  } catch (error) {
    if (error instanceof z.ZodError) {
      return {
        success: false,
        errors: error.errors.map((err) => ({
          field: err.path.join("."),
          message: err.message,
        })),
      };
    }

    return {
      success: false,
      error: error instanceof Error ? error.message : "An error occurred",
    };
  }
}
```

## Form Patterns

### Multi-Step Forms

- Break complex forms into logical steps
- Maintain form state across steps
- Provide clear progress indicators
- Allow navigation between steps

```tsx
// ✅ Good - Multi-step form
export function MultiStepSessionForm() {
  const [currentStep, setCurrentStep] = useState(1);
  const totalSteps = 3;

  const form = useForm<SessionFormData>({
    resolver: zodResolver(sessionSchema),
    defaultValues: {
      title: "",
      description: "",
      track_id: "",
      tags: [],
    },
  });

  const nextStep = () => {
    if (currentStep < totalSteps) {
      setCurrentStep(currentStep + 1);
    }
  };

  const prevStep = () => {
    if (currentStep > 1) {
      setCurrentStep(currentStep - 1);
    }
  };

  return (
    <div className="space-y-6">
      {/* Progress indicator */}
      <div className="flex items-center space-x-2">
        {Array.from({ length: totalSteps }).map((_, i) => (
          <div
            key={i}
            className={cn(
              "h-2 flex-1 rounded-full",
              i + 1 <= currentStep ? "bg-primary" : "bg-muted"
            )}
          />
        ))}
      </div>

      {/* Form steps */}
      {currentStep === 1 && (
        <div className="space-y-4">
          <h3 className="text-lg font-semibold">Basic Information</h3>
          <FormField
            label="Session Title"
            name="title"
            register={form.register}
            error={form.formState.errors.title?.message}
            required
          />
          <FormField
            label="Description"
            name="description"
            type="textarea"
            register={form.register}
            error={form.formState.errors.description?.message}
          />
        </div>
      )}

      {currentStep === 2 && (
        <div className="space-y-4">
          <h3 className="text-lg font-semibold">Track & Tags</h3>
          <TrackSelector
            value={form.watch("track_id")}
            onChange={(value) => form.setValue("track_id", value)}
          />
          <TagSelector
            value={form.watch("tags")}
            onChange={(value) => form.setValue("tags", value)}
          />
        </div>
      )}

      {currentStep === 3 && (
        <div className="space-y-4">
          <h3 className="text-lg font-semibold">Review & Submit</h3>
          <SessionSummary data={form.getValues()} />
        </div>
      )}

      {/* Navigation */}
      <div className="flex items-center justify-between">
        <Button
          type="button"
          variant="outline"
          onClick={prevStep}
          disabled={currentStep === 1}
        >
          Previous
        </Button>

        {currentStep < totalSteps ? (
          <Button type="button" onClick={nextStep}>
            Next
          </Button>
        ) : (
          <Button
            type="submit"
            onClick={form.handleSubmit(onSubmit)}
            disabled={form.formState.isSubmitting}
          >
            {form.formState.isSubmitting ? "Creating..." : "Create Session"}
          </Button>
        )}
      </div>
    </div>
  );
}
```

### Dynamic Forms

- Handle conditional form fields
- Use field arrays for repeatable sections
- Implement dynamic validation
- Manage complex form state

```tsx
// ✅ Good - Dynamic form with field arrays
export function DynamicSessionForm() {
  const form = useForm<SessionFormData>({
    resolver: zodResolver(sessionSchema),
  });

  const { fields, append, remove } = useFieldArray({
    control: form.control,
    name: "tags",
  });

  return (
    <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-6">
      {/* Basic fields */}
      <FormField
        label="Session Title"
        name="title"
        register={form.register}
        error={form.formState.errors.title?.message}
        required
      />

      {/* Dynamic tags */}
      <div className="space-y-4">
        <Label>Tags</Label>
        {fields.map((field, index) => (
          <div key={field.id} className="flex items-center space-x-2">
            <Input
              {...form.register(`tags.${index}`)}
              placeholder="Enter tag name"
            />
            <Button
              type="button"
              variant="outline"
              size="icon"
              onClick={() => remove(index)}
            >
              <X className="h-4 w-4" />
            </Button>
          </div>
        ))}
        <Button type="button" variant="outline" onClick={() => append("")}>
          Add Tag
        </Button>
      </div>

      <Button type="submit" disabled={form.formState.isSubmitting}>
        Save Session
      </Button>
    </form>
  );
}
```

## Error Handling

### Form Error States

- Display field-specific errors
- Show form-level errors
- Handle network errors gracefully
- Provide retry mechanisms

```tsx
// ✅ Good - Comprehensive error handling
export function SessionFormWithErrors() {
  const [formError, setFormError] = useState<string | null>(null);

  const form = useForm<SessionFormData>({
    resolver: zodResolver(sessionSchema),
  });

  const onSubmit = async (data: SessionFormData) => {
    try {
      setFormError(null);
      await createSession(data);
      // Handle success
    } catch (error) {
      if (error instanceof z.ZodError) {
        // Handle validation errors
        error.errors.forEach((err) => {
          form.setError(err.path.join(".") as any, {
            type: "server",
            message: err.message,
          });
        });
      } else {
        // Handle other errors
        setFormError(
          error instanceof Error ? error.message : "An error occurred"
        );
      }
    }
  };

  return (
    <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-6">
      {/* Form-level error */}
      {formError && (
        <Alert variant="destructive">
          <AlertCircle className="h-4 w-4" />
          <AlertDescription>{formError}</AlertDescription>
        </Alert>
      )}

      {/* Form fields */}
      <FormField
        label="Session Title"
        name="title"
        register={form.register}
        error={form.formState.errors.title?.message}
        required
      />

      {/* Submit button */}
      <Button
        type="submit"
        disabled={form.formState.isSubmitting}
        className="w-full"
      >
        {form.formState.isSubmitting ? (
          <>
            <Loader2 className="mr-2 h-4 w-4 animate-spin" />
            Creating Session...
          </>
        ) : (
          "Create Session"
        )}
      </Button>
    </form>
  );
}
```

### Validation Feedback

- Provide immediate feedback
- Use appropriate error styling
- Show success states
- Guide users to fix errors

```tsx
// ✅ Good - Validation feedback
export function FormFieldWithFeedback({
  label,
  name,
  register,
  error,
  touched,
  ...props
}: FormFieldProps) {
  const [isTouched, setIsTouched] = useState(false);
  const hasError = error && (touched || isTouched);

  return (
    <div className="space-y-2">
      <Label htmlFor={name}>{label}</Label>

      <div className="relative">
        <Input
          id={name}
          {...register(name)}
          onBlur={() => setIsTouched(true)}
          className={cn(
            hasError && "border-destructive focus-visible:ring-destructive",
            !hasError &&
              isTouched &&
              "border-green-500 focus-visible:ring-green-500"
          )}
          {...props}
        />

        {/* Success indicator */}
        {!hasError && isTouched && (
          <Check className="absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-green-500" />
        )}

        {/* Error indicator */}
        {hasError && (
          <X className="absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-destructive" />
        )}
      </div>

      {hasError && (
        <p className="text-sm text-destructive flex items-center">
          <AlertCircle className="mr-1 h-3 w-3" />
          {error}
        </p>
      )}
    </div>
  );
}
```
