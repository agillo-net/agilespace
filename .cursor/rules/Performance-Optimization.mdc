## Data Fetching Optimization

### TanStack Query Optimization

- Use appropriate stale times
- Implement proper cache invalidation
- Use optimistic updates
- Leverage background refetching

```tsx
// ✅ Good - Optimized data fetching
export function useSessionsApi(spaceId: string) {
  return useQuery({
    queryKey: ["sessions", spaceId],
    queryFn: () => getSessions(spaceId),
    staleTime: 5 * 60 * 1000, // 5 minutes
    gcTime: 10 * 60 * 1000, // 10 minutes
    refetchOnWindowFocus: false,
    refetchOnReconnect: true,
  });
}

// ✅ Good - Optimistic updates
export function useCreateSessionApi() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: createSession,
    onMutate: async (newSession) => {
      // Cancel outgoing refetches
      await queryClient.cancelQueries({ queryKey: ["sessions"] });

      // Snapshot previous value
      const previousSessions = queryClient.getQueryData([
        "sessions",
        newSession.space_id,
      ]);

      // Optimistically update
      queryClient.setQueryData(
        ["sessions", newSession.space_id],
        (old: Session[] = []) => [
          ...old,
          {
            ...newSession,
            id: "temp-id",
            created_at: new Date().toISOString(),
          },
        ]
      );

      return { previousSessions };
    },
    onError: (err, newSession, context) => {
      // Revert on error
      queryClient.setQueryData(
        ["sessions", newSession.space_id],
        context?.previousSessions
      );
    },
    onSettled: () => {
      // Always refetch after error or success
      queryClient.invalidateQueries({ queryKey: ["sessions"] });
    },
  });
}
```

### Pagination and Infinite Loading

- Implement proper pagination
- Use infinite queries for large datasets
- Cache paginated data efficiently
- Handle loading states properly

```tsx
// ✅ Good - Infinite loading
export function useInfiniteSessionsApi(spaceId: string) {
  return useInfiniteQuery({
    queryKey: ["sessions", "infinite", spaceId],
    queryFn: ({ pageParam = 0 }) => getSessionsPaginated(spaceId, pageParam),
    getNextPageParam: (lastPage, pages) => {
      return lastPage.hasMore ? pages.length : undefined;
    },
    staleTime: 5 * 60 * 1000,
    gcTime: 10 * 60 * 1000,
  });
}

// ✅ Good - Paginated list component
export function InfiniteSessionList({ spaceId }: { spaceId: string }) {
  const { data, fetchNextPage, hasNextPage, isFetchingNextPage, isLoading } =
    useInfiniteSessionsApi(spaceId);

  const allSessions = useMemo(() => {
    return data?.pages.flatMap((page) => page.sessions) ?? [];
  }, [data]);

  if (isLoading) {
    return <SessionListSkeleton />;
  }

  return (
    <div className="space-y-4">
      {allSessions.map((session) => (
        <SessionCard key={session.id} session={session} />
      ))}

      {hasNextPage && (
        <div className="flex justify-center">
          <Button
            onClick={() => fetchNextPage()}
            disabled={isFetchingNextPage}
            variant="outline"
          >
            {isFetchingNextPage ? "Loading..." : "Load More"}
          </Button>
        </div>
      )}
    </div>
  );
}
```

