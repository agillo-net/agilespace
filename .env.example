# Supabase Configuration
# Get these values from your Supabase project dashboard (Settings > API)

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (public, safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (secret, only use in backend/scripts)
# WARNING: This key has full database access. Never commit this to git or expose in frontend!
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Supabase Project ID (for generating types)
SUPABASE_PROJECT_ID=your-project-id

# Optional: PostgreSQL Direct Connection (for psql commands)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
# You can find this in: Supabase Dashboard > Project Settings > Database > Connection string
# DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# GitHub OAuth Configuration
# Get these from: https://github.com/settings/developers
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=your-github-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=your-github-oauth-secret

# GitHub Personal Access Token (for GitHub API calls)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:user, user:email, read:org
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_personal_access_token
